# ==============================================================
# GenAI Clothing Store - Environment Variables Configuration
# Copy this file to .env and replace placeholder values.
# ==============================================================

# Server Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# MongoDB Connection
# For local MongoDB container: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=clothing_store_db

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_secure_random_64_character_hex_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider: Groq (Get your key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_placeholder
GROQ_MODEL=llama-3.3-70b-versatile
AI_MOCK_MODE=False

# Media & Storage Settings
# STORAGE_BACKEND: 'local' (saves to backend/uploads) or 's3' (saves to AWS S3)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# AWS Cloud Settings (Used when STORAGE_BACKEND=s3 or for AWS ECS Deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=clothing-store-media-assets
CLOUDFRONT_DOMAIN=

# Initial Superadmin Credentials (used by scripts/create_admin.py)
ADMIN_EMAIL=admin@clothingstore.com
ADMIN_PASSWORD=AdminStrongPass123!
